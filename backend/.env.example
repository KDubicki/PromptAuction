APP_NAME=PromptAuction API
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=promptauction
GAME_ROUNDS=50
GAME_ITERATIONS_PER_ROUND=45
GAME_ENGINE_SLEEP_SECONDS=1

# Comma-separated frontend origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173

# Google Forms — service account used to pull player prompts (see docs/google-forms-setup.md)
# Set ONE of these: the key file path, or the whole key JSON on a single line.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_FORMS_POLL_SECONDS=30

# Webhook security (leave empty to disable verification)
WEBHOOK_SECRET=

# LLM Provider Configuration
# Available providers: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_FALLBACK_PROVIDER=
